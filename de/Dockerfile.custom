# Builds Libredesk from this folder's source (your theme, login page and mobile edits included).
# Mirrors the project's Makefile: build frontend -> build Go binary -> stuff assets into the binary.

# ---------- 1. Frontend ----------
FROM node:22-alpine AS frontend
ENV CYPRESS_INSTALL_BINARY=0
RUN npm install -g pnpm@9.15.3
WORKDIR /src
# Install deps first so this layer is cached between rebuilds
COPY frontend/package.json frontend/pnpm-lock.yaml ./frontend/
RUN cd frontend && pnpm install --frozen-lockfile
COPY . .
ARG VERSION=custom
RUN cd frontend \
 && VITE_APP_VERSION="${VERSION}" pnpm build:main \
 && VITE_APP_VERSION="${VERSION}" pnpm build:widget \
 && pnpm build:widget-loader

# ---------- 2. Backend + asset stuffing ----------
FROM golang:1.25-alpine AS backend
RUN apk add --no-cache git
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
COPY --from=frontend /src/frontend/dist ./frontend/dist
COPY --from=frontend /src/static/widget.min.js ./static/widget.min.js
ARG VERSION=custom
RUN go install github.com/knadh/stuffbin/...
RUN CGO_ENABLED=0 go build \
      -ldflags="-s -w -X 'main.buildString=${VERSION}' -X 'main.versionString=${VERSION}' -X 'github.com/abhinavxd/libredesk/internal/version.Version=${VERSION}'" \
      -o libredesk cmd/*.go
RUN /go/bin/stuffbin -a stuff -in libredesk -out libredesk \
      frontend/dist i18n schema.sql static/email-templates static/public static/widget.min.js:static/widget.js

# ---------- 3. Runtime ----------
FROM alpine:3.20
RUN apk --no-cache add ca-certificates tzdata
WORKDIR /libredesk
COPY --from=backend /src/libredesk .
EXPOSE 9000
CMD ["./libredesk"]
